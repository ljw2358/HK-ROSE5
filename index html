        function setProductType(type) {
            currentType = type;
            const depBtn = document.getElementById('type-deposit');
            const savBtn = document.getElementById('type-saving');

            if(type === 'deposit') {
                depBtn.className = "px-3 py-1 rounded-md bg-purple-600 text-yellow-400 font-bold";
                savBtn.className = "px-3 py-1 rounded-md text-gray-400 hover:text-white";
            } else {
