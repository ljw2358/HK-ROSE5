    <script>
        // AGI 삐니 대화 로직
        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const windowObj = document.getElementById('chatWindow');
            const txt = input.value.trim();
            if (!txt) return;

            const uDiv = document.createElement('div');
            uDiv.className = 'chat-msg user';
            uDiv.innerHTML = `<strong>사용자:</strong> ${txt}`;
            windowObj.appendChild(uDiv);

            setTimeout(() => {
                const bDiv = document.createElement('div');
                bDiv.className = 'chat-msg bot';
                
                let reply = `'${txt}' 문의를 접수하였습니다. AGI 삐니가 관련 백서 및 10대 모듈 데이터베이스를 검증 중입니다.`;
                if (txt.includes('예치') || txt.includes('이율')) {
                    reply = "HK WorldBank 예치 이율은 자율입출금 8.5%, 1년 약정 15.5%, 2~3년 확정 예치 시 최대 31.4% APY가 연동됩니다.";
                } else if (txt.includes('추천') || txt.includes('ID')) {
                    reply = "공식 추천인 ID는 'ljw2358'입니다. 가입 시 입력하시면 네트워크 기여도 리워드를 받으실 수 있습니다.";
                } else if (txt.includes('파이') || txt.includes('Pi')) {
                    reply = "파이수량 모듈을 통해 Pi Network 통합 잔액을 연동하며 모든 기능은 Test Pi 기반에서 안전하게 구동됩니다.";
                } else if (txt.includes('환원') || txt.includes('UBI')) {
                    reply = "플랫폼 순수익의 30%~60%가 스마트 계약을 통해 글로벌 기본소득(UBI) 및 HK 사회재단으로 투명하게 환원됩니다.";
                }

                bDiv.innerHTML = `<strong>삐니:</strong> ${reply}`;
                windowObj.appendChild(bDiv);
                windowObj.scrollTop = windowObj.scrollHeight;
            }, 350);

            input.value = '';
            windowObj.scrollTop = windowObj.scrollHeight;
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter') sendChatMessage();
        }

        function triggerModule(name) {
            alert(`[HK WorldBank] '${name}' 모듈 프로세스를 실행합니다 (Test Pi 시뮬레이션 지원).`);
        }

        // 시뮬레이터 계산 로직
        function calcSim() {
            const profit = parseFloat(document.getElementById('simProfit').value) || 0;
            const ratio = parseInt(document.getElementById('simRatio').value) || 50;
            
            document.getElementById('simRatioText').innerText = ratio + '%';

            const totalSocial = profit * (ratio / 100);
            const ubiPart = totalSocial * 0.5;
            const foundationPart = totalSocial * 0.5;

            document.getElementById('resTotal').innerText = totalSocial.toLocaleString() + ' 원';
            document.getElementById('resUBI').innerText = ubiPart.toLocaleString() + ' 원';
            document.getElementById('resFoundation').innerText = foundationPart.toLocaleString() + ' 원';
        }
    </script>
