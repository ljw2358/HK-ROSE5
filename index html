    <script>
        // 6-Digit PIN Security Logic
        const CORRECT_PIN = "123456";
        let enteredPin = "";

        function pressPin(num) {
            if (enteredPin.length < 6) {
                enteredPin += num;
                updatePinDots();
                if (enteredPin.length === 6) {
                    setTimeout(verifyPin, 200);
                }
            }
        }

        function deletePin() {
            if (enteredPin.length > 0) {
                enteredPin = enteredPin.slice(0, -1);
                updatePinDots();
            }
        }

        function clearPin() {
            enteredPin = "";
            updatePinDots();
            document.getElementById('pin-error').innerText = "";
        }

        function updatePinDots() {
            for (let i = 0; i < 6; i++) {
                const dot = document.getElementById(`dot-${i}`);
                if (i < enteredPin.length) {
                    dot.classList.add("bg-amber-400");
                } else {
                    dot.classList.remove("bg-amber-400");
                }
            }
        }

        function verifyPin() {
            if (enteredPin === CORRECT_PIN) {
                document.getElementById('pin-lock-screen').style.opacity = '0';
                document.getElementById('pin-lock-screen').style.transition = 'opacity 0.5s ease';
                setTimeout(() => {
                    document.getElementById('pin-lock-screen').style.display = 'none';
                }, 500);
            } else {
                document.getElementById('pin-error').innerText = "비밀번호가 일치하지 않습니다. (기본: 123456)";
                shakeLockScreen();
                enteredPin = "";
                updatePinDots();
            }
        }

        function shakeLockScreen() {
            const card = document.querySelector('#pin-lock-screen > div');
            card.classList.add('animate-bounce');
            setTimeout(() => card.classList.remove('animate-bounce'), 500);
        }

        let currentType = 'deposit';
        let currentPeriodYears = 1;
        let currentRate = 13.0;
        let activeModId = null;

        function setProductType(type) {
            currentType = type;
            const depBtn = document.getElementById('type-deposit');
            const savBtn = document.getElementById('type-saving');

            if(type === 'deposit') {
                depBtn.className = "px-2.5 py-1 rounded-md bg-purple-600 text-amber-300 font-bold transition";
                savBtn.className = "px-2.5 py-1 rounded-md text-gray-400 hover:text-white transition";
            } else {
                savBtn.className = "px-2.5 py-1 rounded-md bg-purple-600 text-amber-300 font-bold transition";
                depBtn.className = "px-2.5 py-1 rounded-md text-gray-400 hover:text-white transition";
            }
            calculateInterest();
        }

        function setPeriod(years, rate) {
            currentPeriodYears = years;
            currentRate = rate;

            const btns = ['period-6m', 'period-1y', 'period-2y', 'period-3y'];
            btns.forEach(id => {
                document.getElementById(id).className = "period-btn py-2 text-xs rounded-xl border border-purple-800 bg-[#120D1E] text-gray-300 font-medium transition";
            });

            let activeId = 'period-1y';
            if(years === 0.5) activeId = 'period-6m';
            if(years === 2) activeId = 'period-2y';
            if(years === 3) activeId = 'period-3y';

            document.getElementById(activeId).className = "period-btn py-2 text-xs rounded-xl border border-amber-400 bg-purple-700/80 text-amber-300 font-bold shadow-lg transition";
            calculateInterest();
        }

        function addAmount(val) {
            const input = document.getElementById('deposit-amount');
            let current = parseInt(input.value) || 0;
            input.value = current + val;
            calculateInterest();
        }

        function calculateInterest() {
            const amountInput = document.getElementById('deposit-amount');
            let principal = parseFloat(amountInput.value) || 0;

            document.getElementById('amount-display-val').innerText = principal.toLocaleString() + ' 원';

            let interest = 0;
            if(currentType === 'deposit') {
                interest = principal * (currentRate / 100) * currentPeriodYears;
            } else {
                const months = currentPeriodYears * 12;
                interest = principal * (currentRate / 100) * ((months + 1) / 24);
            }

            const tax = interest * 0.154;
            const netInterest = interest - tax;
            const totalReturn = principal + netInterest;

            document.getElementById('res-rate').innerText = '연 ' + currentRate.toFixed(1) + '% (가변)';
            document.getElementById('res-before-tax').innerText = Math.round(interest).toLocaleString() + ' 원';
            document.getElementById('res-tax').innerText = '-' + Math.round(tax).toLocaleString() + ' 원';
            document.getElementById('res-total').innerText = Math.round(totalReturn).toLocaleString() + ' 원';
        }

        function openApplyModal() {
            const amount = parseInt(document.getElementById('deposit-amount').value) || 0;
            document.getElementById('modal-product-type').innerText = currentType === 'deposit' ? '정기예금' : '정기적금';
            document.getElementById('modal-period').innerText = (currentPeriodYears < 1 ? '1년 미만' : currentPeriodYears + '년') + ' (가변금리)';
            document.getElementById('modal-rate').innerText = '연 ' + currentRate.toFixed(1) + '%';
            document.getElementById('modal-amount').innerText = amount.toLocaleString() + ' 원';
            document.getElementById('apply-modal').classList.remove('hidden');
        }

