<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HK WorldBank - Global Digital Banking Platform (hkwb.world)</title>
    <style>
        :root {
            --bg-dark: #030508;
            --bg-gradient: linear-gradient(135deg, #0b0f19 0%, #1a1a2e 40%, #05070b 100%);
            --panel-bg: rgba(26, 26, 46, 0.92);
            --panel-border: rgba(74, 74, 226, 0.4);
            --neon-cyan: #00ffcc;
            --neon-blue: #4a4ae2;
            --text-main: #ffffff;
            --text-sub: #a0aec0;
            --accent-purple: #9f7aea;
            --success-green: #38ef7d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: var(--bg-dark);
            background-image: var(--bg-gradient);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Header & Navigation */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            background: rgba(11, 15, 25, 0.98);
            border-bottom: 1px solid rgba(74, 74, 226, 0.3);
            backdrop-filter: blur(15px);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 25px rgba(0,0,0,0.6);
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-badge {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.95rem;
            box-shadow: 0 0 15px rgba(255, 65, 108, 0.4);
        }

        .platform-title {
            font-size: 1.25rem;
            font-weight: bold;
            letter-spacing: 0.5px;
            color: var(--text-main);
        }

        .nav-links {
            display: flex;
            gap: 25px;
            font-size: 0.95rem;
            color: var(--text-sub);
        }

        .nav-links span {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .nav-links span:hover {
            color: var(--neon-cyan);
            text-shadow: 0 0 10px rgba(0,255,204,0.5);
        }

        .lang-select {
            background: #1a1a2e;
            color: var(--neon-cyan);
            padding: 8px 16px;
            border: 1px solid var(--neon-blue);
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            outline: none;
            transition: all 0.3s;
        }

        .lang-select:hover {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 12px rgba(0,255,204,0.3);
        }

        /* Main Container */
        main {
            flex: 1;
            max-width: 1450px;
            margin: 0 auto;
            padding: 40px;
            width: 100%;
        }

        /* Section Header Banner */
        .section-header {
            background: linear-gradient(90deg, rgba(74, 74, 226, 0.25), transparent);
            border-left: 5px solid var(--neon-cyan);
            padding: 16px 24px;
            margin-bottom: 30px;
            border-radius: 0 10px 10px 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .section-header h2 {
            font-size: 1.5rem;
            color: var(--text-main);
        }

        .section-header p {
            font-size: 0.9rem;
            color: var(--text-sub);
            margin-top: 6px;
        }

        /* 10 Core Modules Grid */
        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 18px;
            margin-bottom: 35px;
        }

        .module-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 14px;
            padding: 22px;
            text-align: center;
            cursor: pointer;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 6px 25px rgba(0,0,0,0.3);
            position: relative;
            overflow: hidden;
        }

        .module-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 3px;
            background: transparent;
            transition: background 0.3s;
        }

        .module-card:hover, .module-card.active {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.25);
            transform: translateY(-4px);
            background: rgba(30, 30, 55, 0.95);
        }

        .module-card:hover::before, .module-card.active::before {
            background: var(--neon-cyan);
        }

        .module-card .icon {
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .module-card h3 {
            font-size: 1.05rem;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .module-card span {
            font-size: 0.75rem;
            color: var(--text-sub);
        }

        /* Simulation Control Panel */
        .sim-panel {
            background: var(--panel-bg);
            border: 1px solid var(--neon-blue);
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
            margin-bottom: 35px;
            backdrop-filter: blur(10px);
        }

        .sim-panel h3 {
            margin-bottom: 25px;
            color: var(--neon-cyan);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1.2rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 15px;
        }

        .sim-controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 25px;
        }

        .control-group label {
            display: block;
            font-size: 0.9rem;
            color: var(--text-sub);
            margin-bottom: 10px;
            font-weight: 500;
        }

        .control-group input, .control-group select {
            width: 100%;
            padding: 14px 18px;
            background: #0f172a;
            border: 1px solid rgba(74, 74, 226, 0.5);
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s;
        }

        .control-group input:focus, .control-group select:focus {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 12px rgba(0,255,204,0.25);
        }

        .action-btn {
            background: linear-gradient(135deg, #00ffcc, #00b09b);
            color: #0b0f19;
            font-weight: bold;
            padding: 14px 30px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 0 20px rgba(0,255,204,0.3);
            font-size: 1rem;
            letter-spacing: 0.5px;
        }

        .action-btn:hover {
            opacity: 0.95;
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(0,255,204,0.5);
        }

        /* Terminal Logs */
        .terminal-container {
            background: #030508;
            border: 1px solid #1e293b;
            border-radius: 14px;
            padding: 20px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.9);
        }

        .terminal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            font-size: 0.85rem;
            color: var(--text-sub);
            border-bottom: 1px solid #1e293b;
            padding-bottom: 8px;
        }

        .terminal-box {
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.9rem;
            height: 220px;
            overflow-y: auto;
            color: var(--success-green);
            line-height: 1.5;
        }

        .terminal-box div {
            margin-bottom: 8px;
            border-left: 2px solid var(--neon-cyan);
            padding-left: 10px;
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 30px;
            background: #04060a;
            border-top: 1px solid rgba(74, 74, 226, 0.2);
            color: var(--text-sub);
            font-size: 0.9rem;
            margin-top: auto;
        }

        footer a {
            color: var(--neon-cyan);
            text-decoration: none;
            transition: color 0.3s;
        }

        footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
