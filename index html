<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HK-BANK Global Web3 Digital Banking</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        darkBg: '#07050D',
                        cardBg: 'rgba(20, 15, 35, 0.85)',
                        accentGold: '#F59E0B',
                        neonPurple: '#8B5CF6'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        body { font-family: 'Pretendard', sans-serif; background-color: #07050D; color: #F3F4F6; }
        .glass-card { background: rgba(18, 13, 30, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(139, 92, 246, 0.25); box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37); }
        .gold-glow { box-shadow: 0 0 25px rgba(245, 158, 11, 0.25); }
        .purple-glow { box-shadow: 0 0 30px rgba(139, 92, 246, 0.3); }
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: #07050D; }
        ::-webkit-scrollbar-thumb { background: #6D28D9; border-radius: 3px; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased selection:bg-amber-400 selection:text-black">

    <!-- 6-Digit PIN Security Lock Screen -->
    <div id="pin-lock-screen" class="fixed inset-0 bg-[#07050D] z-50 flex items-center justify-center p-4">
        <div class="glass-card max-w-sm w-full rounded-3xl p-6 border border-amber-500/40 text-center space-y-6 gold-glow">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-amber-400 mx-auto flex items-center justify-center font-black text-black text-2xl shadow-xl">
                <i class="fas fa-lock"></i>
            </div>
            <div>
                <h3 class="text-xl font-black text-white">HK-BANK 보안 인증</h3>
                <p class="text-xs text-purple-300 mt-1">접속을 위해 **6자리 비밀번호**를 입력하세요</p>
                <p class="text-[10px] text-gray-400 mt-0.5">(초기 기본 비밀번호: 123456)</p>
            </div>

            <!-- PIN Display Dots -->
            <div class="flex justify-center space-x-3 py-2">
                <div class="w-4 h-4 rounded-full border-2 border-amber-400 pin-dot" id="dot-0"></div>
                <div class="w-4 h-4 rounded-full border-2 border-amber-400 pin-dot" id="dot-1"></div>
                <div class="w-4 h-4 rounded-full border-2 border-amber-400 pin-dot" id="dot-2"></div>
                <div class="w-4 h-4 rounded-full border-2 border-amber-400 pin-dot" id="dot-3"></div>
                <div class="w-4 h-4 rounded-full border-2 border-amber-400 pin-dot" id="dot-4"></div>
                <div class="w-4 h-4 rounded-full border-2 border-amber-400 pin-dot" id="dot-5"></div>
            </div>
            <p id="pin-error" class="text-xs text-red-400 h-4"></p>

            <!-- Keypad -->
            <div class="grid grid-cols-3 gap-3">
                <button onclick="pressPin('1')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">1</button>
                <button onclick="pressPin('2')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">2</button>
                <button onclick="pressPin('3')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">3</button>
                <button onclick="pressPin('4')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">4</button>
                <button onclick="pressPin('5')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">5</button>
                <button onclick="pressPin('6')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">6</button>
                <button onclick="pressPin('7')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">7</button>
                <button onclick="pressPin('8')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">8</button>
                <button onclick="pressPin('9')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">9</button>
                <button onclick="clearPin()" class="bg-red-950/40 hover:bg-red-900/50 border border-red-900 text-red-300 font-bold py-3.5 rounded-xl text-xs transition">전체삭제</button>
                <button onclick="pressPin('0')" class="bg-purple-950/60 hover:bg-purple-900 border border-purple-800 text-white font-bold py-3.5 rounded-xl text-lg transition">0</button>
                <button onclick="deletePin()" class="bg-purple-900/60 hover:bg-purple-800 border border-purple-700 text-amber-300 font-bold py-3.5 rounded-xl text-xs transition"><i class="fas fa-backspace"></i></button>
            </div>
        </div>
    </div>

    <!-- Top Header -->
    <header class="sticky top-0 z-40 glass-card border-b border-purple-900/50 px-4 py-3">
        <div class="max-w-md mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-amber-400 flex items-center justify-center font-black text-black text-lg shadow-lg">HK</div>
                <div>
                    <span class="text-base font-extrabold tracking-tight bg-gradient-to-r from-amber-300 via-purple-200 to-white bg-clip-text text-transparent">HK-BANK</span>
                    <span class="block text-[9px] text-amber-400/90 font-medium">KYC/KYB Gate Live</span>
                </div>
            </div>
            
            <div class="flex items-center space-x-2">
                <select id="lang-select" onchange="changeLanguage(this.value)" class="bg-[#120D1E] text-amber-300 text-[11px] border border-purple-800 rounded-lg px-2 py-1.5 focus:outline-none focus:border-amber-400 font-semibold cursor-pointer">
                    <option value="ko">🇰🇷 한국어</option>
                    <option value="en">🇺🇸 English</option>
                    <option value="zh">🇨🇳 中文</option>
                    <option value="ja">🇯🇵 日本語</option>
                </select>
                <button onclick="switchTab('wallet')" class="text-xs bg-purple-950/80 hover:bg-purple-900 text-amber-300 border border-purple-700/50 px-3 py-1.5 rounded-full flex items-center gap-1.5 transition font-medium">
                    <i class="fas fa-wallet text-[10px]"></i> <span id="wallet-status">지갑연결</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto w-full px-4 py-5 flex-1 space-y-5">

        <!-- Banner Card -->
        <section class="glass-card rounded-2xl p-5 border border-amber-500/30 gold-glow relative overflow-hidden">
            <div class="absolute -right-8 -top-8 w-32 h-32 bg-purple-600/15 rounded-full blur-2xl"></div>
            <div class="flex justify-between items-center mb-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-400 text-black uppercase tracking-wider">KYC / KYB Enforced</span>
                <span class="text-[11px] text-purple-300 flex items-center gap-1"><i class="fas fa-shield-alt text-amber-400"></i> 검증 시스템 가동</span>
            </div>
            <h2 class="text-2xl font-black text-white tracking-tight mt-1">
                가변형 파격 금리 <span class="text-amber-400 font-extrabold">최고 연 20.0%</span>
            </h2>
            <p class="text-xs text-gray-300 mt-1 leading-relaxed">
                미인증 사용자는 테스트 파이(Test Pi) 모드로 둘러보기만 가능합니다. 정식 KYC/KYB 승인 후 모든 모듈 가동!
            </p>
        </section>

        <!-- Variable Rate Info Notice -->
        <div class="bg-purple-950/40 border border-purple-800/50 rounded-xl p-3 flex items-start space-x-2.5">
            <i class="fas fa-info-circle text-amber-400 mt-0.5 text-xs"></i>
            <p class="text-[11px] text-purple-200/90 leading-tight">
                <strong class="text-amber-300">이율 가변 안내:</strong> 본 상품의 적용 금리는 글로벌 시장 유동성 및 생태계 정책에 따라 탄력적으로 조정(가변)될 수 있습니다.
            </p>
        </div>

        <!-- Rate Cards Grid -->
        <section class="grid grid-cols-4 gap-2">
            <div class="glass-card p-2 rounded-xl text-center border border-purple-900/50">
                <div class="text-[10px] text-gray-400">1년 미만</div>
                <div class="text-base font-bold text-amber-400 mt-0.5">6.0%</div>
                <div class="text-[8px] text-purple-300">단기거치</div>
            </div>
            <div class="glass-card p-2 rounded-xl text-center border border-purple-700/60 bg-purple-900/10">
                <div class="text-[10px] text-gray-300">1년 만기</div>
                <div class="text-base font-bold text-amber-400 mt-0.5">13.0%</div>
                <div class="text-[8px] text-purple-300">기준금리</div>
            </div>
            <div class="glass-card p-2 rounded-xl text-center border border-purple-600/70 bg-purple-900/20">
                <div class="text-[10px] text-gray-300">2년 만기</div>
                <div class="text-base font-bold text-amber-400 mt-0.5">16.0%</div>
                <div class="text-[8px] text-purple-300">우대성장</div>
            </div>
            <div class="glass-card p-2 rounded-xl text-center border border-amber-500/50 bg-amber-400/10 gold-glow">
                <div class="text-[10px] text-amber-300 font-bold">3년 만기</div>
                <div class="text-lg font-black text-amber-400 mt-0.5">20.0%</div>
                <div class="text-[8px] text-amber-200">최고혜택</div>
            </div>
        </section>

        <!-- Simulator Section -->
        <section class="glass-card rounded-2xl p-5 border border-purple-800/40">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-purple-900/60">
                <h3 class="font-bold text-sm text-amber-400 flex items-center gap-2">
                    <i class="fas fa-sliders-h"></i> <span>시뮬레이터 & 약정 기간 선택</span>
                </h3>
                <div class="flex bg-[#120D1E] p-1 rounded-lg text-xs border border-purple-900">
                    <button id="type-deposit" onclick="setProductType('deposit')" class="px-2.5 py-1 rounded-md bg-purple-600 text-amber-300 font-bold transition">예금</button>
                    <button id="type-saving" onclick="setProductType('saving')" class="px-2.5 py-1 rounded-md text-gray-400 hover:text-white transition">적금</button>
                </div>
            </div>

            <!-- Amount Input -->
            <div class="space-y-1.5 mb-4">
                <label class="text-xs text-gray-300 flex justify-between">
                    <span>예치 금액 (Test Pi / KRW)</span>
                    <span id="amount-display-val" class="text-amber-400 font-bold">10,000,000 원</span>
                </label>
                <div class="relative">
                    <input type="number" id="deposit-amount" value="10000000" oninput="calculateInterest()" class="w-full bg-[#120D1E] border border-purple-800/80 rounded-xl py-2.5 px-3 text-right text-white font-bold text-lg focus:outline-none focus:border-amber-400 pr-10">
                    <span class="absolute right-3 top-3 text-xs text-purple-400 font-bold">원</span>
                </div>
                <div class="grid grid-cols-4 gap-1.5 pt-1">
                    <button onclick="addAmount(1000000)" class="text-[11px] bg-purple-950 hover:bg-purple-900 text-purple-200 py-1 rounded-lg border border-purple-800/50">+1M</button>
                    <button onclick="addAmount(5000000)" class="text-[11px] bg-purple-950 hover:bg-purple-900 text-purple-200 py-1 rounded-lg border border-purple-800/50">+5M</button>
                    <button onclick="addAmount(10000000)" class="text-[11px] bg-purple-950 hover:bg-purple-900 text-purple-200 py-1 rounded-lg border border-purple-800/50">+10M</button>
                    <button onclick="addAmount(50000000)" class="text-[11px] bg-purple-950 hover:bg-purple-900 text-purple-200 py-1 rounded-lg border border-purple-800/50">+50M</button>
                </div>
            </div>

            <!-- Period Selection Buttons -->
            <div class="space-y-1.5 mb-5">
                <label class="text-xs text-gray-300">약정 기간 선택 (가변 금리 적용)</label>
                <div class="grid grid-cols-4 gap-2">
                    <button onclick="setPeriod(0.5, 6.0)" id="period-6m" class="period-btn py-2 text-xs rounded-xl border border-purple-800 bg-[#120D1E] text-gray-300 font-medium transition">1년 미만<br><span class="text-amber-400 font-bold">6.0%</span></button>
                    <button onclick="setPeriod(1, 13.0)" id="period-1y" class="period-btn py-2 text-xs rounded-xl border border-amber-400 bg-purple-700/80 text-amber-300 font-bold shadow-lg transition">1년<br><span>13.0%</span></button>
                    <button onclick="setPeriod(2, 16.0)" id="period-2y" class="period-btn py-2 text-xs rounded-xl border border-purple-800 bg-[#120D1E] text-gray-300 font-medium transition">2년<br><span class="text-amber-400 font-bold">16.0%</span></button>
                    <button onclick="setPeriod(3, 20.0)" id="period-3y" class="period-btn py-2 text-xs rounded-xl border border-purple-800 bg-[#120D1E] text-gray-300 font-medium transition">3년<br><span class="text-amber-400 font-bold">20.0%</span></button>
                </div>
            </div>

            <!-- Result Box -->
            <div class="bg-[#120D1E]/90 rounded-xl p-4 border border-purple-900 space-y-2">
                <div class="flex justify-between text-xs text-gray-400">
                    <span>적용 연 이율 (가변)</span>
                    <span id="res-rate" class="text-amber-400 font-bold">연 13.0%</span>
                </div>
                <div class="flex justify-between text-xs text-gray-400">
                    <span>세전 총 예상 이자</span>
                    <span id="res-before-tax" class="text-white font-medium">1,300,000 원</span>
                </div>
                <div class="flex justify-between text-xs text-gray-400">
                    <span>이자소득세 (15.4%)</span>
                    <span id="res-tax" class="text-red-400 font-medium">-200,200 원</span>
                </div>
                <div class="border-t border-purple-900/80 pt-2 flex justify-between items-center">
                    <span class="text-xs font-bold text-purple-200">만기 예상 실수령액</span>
                    <span id="res-total" class="text-lg font-black text-amber-400">11,099,800 원</span>
                </div>
            </div>

            <button onclick="openApplyModal()" class="w-full mt-4 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-black font-extrabold py-3 rounded-xl shadow-lg transition text-sm flex items-center justify-center gap-2">
                <i class="fas fa-shield-alt"></i> KYC / KYB 검증 후 가입 신청
            </button>
            <p class="text-[10px] text-gray-400 text-center mt-2">※ 미인증자는 둘러보기(Test Pi) 모드만 지원됩니다.</p>
        </section>

        <!-- 10 Core Modules Grid (Fully Active with KYC Check) -->
        <section class="space-y-3">
            <div class="flex justify-between items-center px-1">
                <h3 class="font-bold text-sm text-purple-200 flex items-center gap-1.5">
                    <i class="fas fa-cubes text-amber-400"></i> <span>HK WorldBank 10대 핵심 모듈 (KYC Gated)</span>
                </h3>
                <span class="text-[10px] text-amber-400 font-medium animate-pulse">● SECURED</span>
            </div>

            <div class="grid grid-cols-2 gap-2.5">
                <div onclick="openModuleModal(1)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-wallet text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">1. 지갑연결</div>
                        <div class="text-[9px] text-amber-300">Pi Direct Link</div>
                    </div>
                </div>
                <div onclick="openModuleModal(2)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-paper-plane text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">2. 송금</div>
                        <div class="text-[9px] text-amber-300">Global Transfer</div>
                    </div>
                </div>
                <div onclick="openModuleModal(3)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-qrcode text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">3. 결제</div>
                        <div class="text-[9px] text-amber-300">QR Payment</div>
                    </div>
                </div>
                <div onclick="openModuleModal(4)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-piggy-bank text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">4. 예치</div>
                        <div class="text-[9px] text-amber-300">High Yield Deposit</div>
                    </div>
                </div>
                <div onclick="openModuleModal(5)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-gift text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">5. 보상</div>
                        <div class="text-[9px] text-amber-300">Ecosystem Reward</div>
                    </div>
                </div>
                <div onclick="openModuleModal(6)" class="glass-card p-3 rounded-xl border border-amber-500/40 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 bg-amber-400/5 group">
                    <div class="w-8 h-8 rounded-lg bg-amber-400/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-hand-holding-usd text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-amber-400">6. 기본소득</div>
                        <div class="text-[9px] text-amber-200">30% UBI Return</div>
                    </div>
                </div>
                <div onclick="openModuleModal(7)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-sync-alt text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">7. 스왑</div>
                        <div class="text-[9px] text-amber-300">Instant Exchange</div>
                    </div>
                </div>
                <div onclick="openModuleModal(8)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-exchange-alt text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">8. DEX 스왑</div>
                        <div class="text-[9px] text-amber-300">Decentralized P2P</div>
                    </div>
                </div>
                <div onclick="openModuleModal(9)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-layer-group text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">9. LP 스테이킹</div>
                        <div class="text-[9px] text-amber-300">Liquidity Pool</div>
                    </div>
                </div>
                <div onclick="openModuleModal(10)" class="glass-card p-3 rounded-xl border border-purple-900/50 hover:border-amber-400 cursor-pointer transition flex items-center space-x-3 group">
                    <div class="w-8 h-8 rounded-lg bg-purple-950 flex items-center justify-center text-amber-400 group-hover:scale-110 transition"><i class="fas fa-coins text-xs"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">10. 테스트 파이</div>
                        <div class="text-[9px] text-amber-300">Test Pi Sim</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- AGI Bbini Support -->
        <section class="glass-card rounded-2xl p-4 border border-purple-800/50 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-600 to-amber-400 flex items-center justify-center font-bold text-black text-base shadow-lg">
                    <i class="fas fa-robot"></i>
                </div>
                <div>
                    <div class="text-xs font-bold text-white flex items-center gap-1.5">
                        <span>고객센터 AGI 삐니</span>
                        <span class="px-1.5 py-0.2 rounded text-[9px] bg-purple-950 text-amber-300 border border-purple-700">60개국어</span>
                    </div>
                    <div class="text-[10px] text-gray-400">KYC/KYB 인증 실시간 AI 지원</div>
                </div>
            </div>
