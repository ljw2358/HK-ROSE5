                subTitle: "Chaque module brille avec des couleurs néon uniques.",
                panelHeader: "Module Actuel : [{modName}]",
                labelAmt: "1. Montant Test Pi",
                labelAddr: "2. Adresse du portefeuille / DID",
                labelNode: "3. Nœud de relais",
                actionBtn: "▶ Exécuter la simulation",
                successSwap: "Succès de correspondance ! [Destinataire : {recipient}] [Dépôt : +{amount} Test-Pi]",
                langChanged: "Traduit en [Français] via le moteur à 60 langues."
            },
            de: {
                mainTitle: "2. 10 Kernmodule",
                subTitle: "Jedes Modul leuchtet in einzigartigen Neonfarben.",
                panelHeader: "Aktuelles Modul: [{modName}]",
                labelAmt: "1. Test-Pi-Menge",
                labelAddr: "2. Empfänger-Wallet-Adresse / DID",
                labelNode: "3. Relay-Node auswählen",
                actionBtn: "▶ Simulation sofort ausführen",
                successSwap: "Übereinstimmung erfolgreich! [Empfänger: {recipient}] [Einzahlung: +{amount} Test-Pi]",
                langChanged: "In [Deutsch] übersetzt über die 60-Sprachen-Engine."
            },
            ru: {
                mainTitle: "2. 10 основных модулей",
                subTitle: "Каждый модуль сияет уникальными неоновыми цветами.",
                panelHeader: "Текущий модуль: [{modName}]",
                labelAmt: "1. Количество Test Pi",
                labelAddr: "2. Адрес кошелька получателя / DID",
                labelNode: "3. Узел ретрансляции",
                actionBtn: "▶ Запустить симуляцию",
                successSwap: "Совпадение успешно! [Получатель: {recipient}] [Депозит: +{amount} Test-Pi]",
                langChanged: "Переведено на [Русский] язык через 60-язычный движок."
            }
        };

        let currentLang = 'ko';
        let activeModuleName = 'DEX스왑';

        // 60개국어 실시간 전환 함수
        function switchLanguage(langCode) {
            currentLang = langCode;
            const dict = i18nDictionary[langCode] || i18nDictionary['en'];
            
            document.getElementById('mainTitle').innerText = dict.mainTitle;
            document.getElementById('subTitle').innerText = dict.subTitle;
            document.getElementById('currentModuleLabel').innerText = `현재 선택된 모듈: [${activeModuleName}] 시뮬레이션 설정`;
            
            document.getElementById('labelAmt').innerText = dict.labelAmt;
            document.getElementById('labelAddr').innerText = dict.labelAddr;
            document.getElementById('labelNode').innerText = dict.labelNode;
            document.getElementById('actionBtn').innerText = dict.actionBtn;

            const timestamp = new Date().toLocaleTimeString();
            const logContainer = document.getElementById('simulationLog');
            logContainer.innerHTML = `<div>[${timestamp}] [시스템] ${dict.langChanged}</div>` + logContainer.innerHTML;
        }

        // 모듈 선택 시각 효과 및 상태 변경
        function selectModule(moduleKey, moduleDisplayName) {
            document.querySelectorAll('.module-card').forEach(card => card.classList.remove('active'));
            event.currentTarget.classList.add('active');
            
            activeModuleName = moduleDisplayName.split('. ')[1] || moduleDisplayName;
            document.getElementById('currentModuleLabel').innerText = `현재 선택된 모듈: [${activeModuleName}] 시뮬레이션 설정`;

            const timestamp = new Date().toLocaleTimeString();
            const logContainer = document.getElementById('simulationLog');
            logContainer.innerHTML = `<div>[${timestamp}] [모듈 전환] [${activeModuleName}] 모듈이 정상 활성화되었습니다.</div>` + logContainer.innerHTML;
        }

        // 상단 네비게이션바 메뉴 액션
        function triggerNavAction(menuType) {
            const timestamp = new Date().toLocaleTimeString();
            const logContainer = document.getElementById('simulationLog');
            let msg = "";
            if(menuType === 'agi') msg = "AGI 삐니 고객센터 및 AI 서포트 모듈 호출 완료.";
            else if(menuType === 'modules') msg = "10대 핵심 모듈 전체 대시보드 동기화 완료.";
            else if(menuType === 'ubi') msg = "사회참여 및 30% UBI 배분 스마트컨트랙트 조회 완료.";
            else if(menuType === 'whitepaper') msg = "HK 백서 100선 아카이브 로드 완료.";
            else if(menuType === 'faq') msg = "FAQ 20선 데이터베이스 인덱싱 완료.";

            logContainer.innerHTML = `<div>[${timestamp}] [내비게이션] ${msg}</div>` + logContainer.innerHTML;
        }

        // 활성화된 모듈 시뮬레이션 실행 (지갑 잔액 정확한 플러스(+) 입금 처리)
        function executeActiveSimulation() {
            const amountInput = document.getElementById('swapAmount');
            const recipientInput = document.getElementById('recipientAddress');
            const logContainer = document.getElementById('simulationLog');

            const amount = parseFloat(amountInput ? amountInput.value : 10);
            const recipient = recipientInput ? recipientInput.value : "GCLUZ...FES2U";
            const timestamp = new Date().toLocaleTimeString();
            const dict = i18nDictionary[currentLang] || i18nDictionary['en'];

            let logText = dict.successSwap
                .replace('{recipient}', recipient)
                .replace('{amount}', amount);

            logContainer.innerHTML = `<div>[${timestamp}] [모듈: ${activeModuleName}] ${logText}</div>` + logContainer.innerHTML;

            updateWalletBalance(amount);
        }

        // 지갑 잔액 동기화 헬퍼 함수
        function updateWalletBalance(deltaAmount) {
            const balanceElement = document.getElementById('walletBalance');
            if (balanceElement) {
                let currentText = balanceElement.innerText.replace(/[^0-9.]/g, '');
                let currentBalance = parseFloat(currentText) || 112.00;
                currentBalance += deltaAmount; // 정확한 플러스(+) 반영
                balanceElement.innerText = `잔액: ${currentBalance.toFixed(2)} Test-Pi`;
            }
        }
    </script>
</body>
