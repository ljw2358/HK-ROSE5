<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HK-BANK Global Web3 Digital Banking</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            bg: '#0B0813',
                            card: '#161224',
                            cardHover: '#1F1A33',
                            purple: '#6C2BD9',
                            purpleLight: '#8B5CF6',
                            neonYellow: '#FACC15',
                            neonGreen: '#10B981',
                            neonBlue: '#3B82F6'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        body { font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif; background-color: #0B0813; color: #FFFFFF; }
        .glass-panel { background: rgba(22, 18, 36, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(139, 92, 246, 0.2); }
        .glow-effect { box-shadow: 0 0 20px rgba(250, 204, 21, 0.25); }
        .glow-purple { box-shadow: 0 0 25px rgba(108, 43, 217, 0.4); }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0B0813; }
        ::-webkit-scrollbar-thumb { background: #6C2BD9; border-radius: 3px; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Top Navigation Header with 60 Languages Selector -->
    <header class="sticky top-0 z-50 glass-panel border-b border-purple-900/40 px-4 py-3">
        <div class="max-w-md mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-700 to-yellow-400 flex items-center justify-center font-black text-black text-xl shadow-lg">HK</div>
                <span class="text-xl font-bold bg-gradient-to-r from-yellow-400 via-purple-300 to-yellow-200 bg-clip-text text-transparent">HK-BANK</span>
            </div>
            
            <div class="flex items-center space-x-2">
                <!-- 60 Languages Dropdown -->
                <div class="relative">
                    <select id="lang-select" onchange="changeLanguage(this.value)" class="bg-purple-950 text-yellow-400 text-xs border border-purple-700 rounded-lg px-2 py-1.5 focus:outline-none focus:border-yellow-400 font-bold">
                        <option value="ko">🇰🇷 한국어 (Korean)</option>
                        <option value="en">🇺🇸 English (US)</option>
                        <option value="zh">🇨🇳 中文 (Chinese)</option>
                        <option value="ja">🇯🇵 日本語 (Japanese)</option>
                        <option value="es">🇪🇸 Español (Spanish)</option>
                        <option value="fr">🇫🇷 Français (French)</option>
                        <option value="de">🇩🇪 Deutsch (German)</option>
                        <option value="ru">🇷🇺 Русский (Russian)</option>
                        <option value="vi">🇻🇳 Tiếng Việt (Vietnamese)</option>
                        <option value="th">🇹🇭 ไทย (Thai)</option>
                        <option value="id">🇮🇩 Bahasa Indonesia</option>
                        <option value="ar">🇸🇦 العربية (Arabic)</option>
                        <option value="hi">🇮🇳 हिन्दी (Hindi)</option>
                        <option value="pt">🇵🇹 Português (Portuguese)</option>
                        <option value="it">🇮🇹 Italiano (Italian)</option>
                        <option value="tr">🇹🇷 Türkçe (Turkish)</option>
                        <option value="uk">🇺🇦 Українська (Ukrainian)</option>
                        <option value="nl">🇳🇱 Nederlands (Dutch)</option>
                        <option value="pl">🇵🇱 Polski (Polish)</option>
                        <option value="sv">🇸🇻 Svenska (Swedish)</option>
                        <option value="ms">🇲🇾 Bahasa Melayu</option>
                        <option value="fil">🇵🇭 Filipino</option>
                        <option value="fa">🇮🇷 فارسی (Persian)</option>
                        <option value="he">🇮🇱 עברית (Hebrew)</option>
                        <option value="bn">🇧🇩 বাংলা (Bengali)</option>
                        <option value="ur">🇵🇰 اردو (Urdu)</option>
                        <option value="el">🇬🇷 Ελληνικά (Greek)</option>
                        <option value="cs">🇨🇿 Čeština (Czech)</option>
                        <option value="hu">🇭🇺 Magyar (Hungarian)</option>
                        <option value="ro">🇷🇴 Română (Romanian)</option>
                        <option value="da">🇩🇰 Dansk (Danish)</option>
                        <option value="fi">🇫🇮 Suomi (Finnish)</option>
                        <option value="no">🇳🇴 Norsk (Norwegian)</option>
                        <option value="sk">🇸🇰 Slovenčina (Slovak)</option>
                        <option value="bg">🇧🇬 Български (Bulgarian)</option>
                        <option value="hr">🇭🇷 Hrvatski (Croatian)</option>
                        <option value="sr">🇷🇸 Српски (Serbian)</option>
                        <option value="lt">🇱🇹 Lietuvių (Lithuanian)</option>
                        <option value="lv">🇱🇻 Latviešu (Latvian)</option>
                        <option value="et">🇪🇪 Eesti (Estonian)</option>
                        <option value="sl">🇸🇮 Slovenščina (Slovenian)</option>
                        <option value="sw">🇰🇪 Kiswahili (Swahili)</option>
                        <option value="af">🇿🇦 Afrikaans</option>
                        <option value="sq">🇦🇱 Shqip (Albanian)</option>
                        <option value="hy">🇦🇲 Հայերեն (Armenian)</option>
                        <option value="az">🇦🇿 Azərbaycanca (Azerbaijani)</option>
                        <option value="eu">🇪🇺 Euskara (Basque)</option>
                        <option value="be">🇧🇾 Беларуская (Belarusian)</option>
                        <option value="bs">🇧🇦 Bosanski (Bosnian)</option>
                        <option value="ca">🇪🇸 Català (Catalan)</option>
                        <option value="eo">🌍 Esperanto</option>
                        <option value="gl">🇪🇸 Galego (Galician)</option>
                        <option value="ka">🇬🇪 ქართული (Georgian)</option>
                        <option value="is">🇮🇸 Íslenska (Icelandic)</option>
                        <option value="ga">🇮🇪 Gaeilge (Irish)</option>
                        <option value="kk">🇰🇿 Қазақ тілі (Kazakh)</option>
                        <option value="ky">🇰🇬 Кыргызча (Kyrgyz)</option>
                        <option value="mk">🇲🇰 Македонски (Macedonian)</option>
                        <option value="mn">🇲🇳 Монгол (Mongolian)</option>
                        <option value="ps">🇦🇫 پښتو (Pashto)</option>
                    </select>
                </div>
                <button onclick="switchTab('wallet')" class="text-xs bg-purple-900/50 hover:bg-purple-800 text-yellow-400 border border-purple-500/30 px-3 py-1.5 rounded-full flex items-center gap-1 transition">
                    <i class="fas fa-wallet"></i> <span id="wallet-status">지갑</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto w-full px-4 py-5 flex-1 space-y-6">

        <!-- Banner Card -->
        <section class="glass-panel rounded-2xl p-5 border border-yellow-500/30 glow-purple relative overflow-hidden">
            <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-purple-600/20 rounded-full blur-xl"></div>
            <div class="flex justify-between items-start mb-2">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-yellow-400 text-black" data-i18n="badge_global">Global Web3 Special</span>
                <span class="text-xs text-purple-300"><i class="fas fa-shield-alt text-yellow-400"></i> KYC/KYB</span>
            </div>
            <h2 class="text-2xl font-black text-white mt-1"><span data-i18n="up_to">최고</span> <span class="text-yellow-400 text-3xl font-extrabold">연 20.0%</span></h2>
            <p class="text-xs text-gray-300 mt-1" data-i18n="banner_desc">전 세계 파이 개척자를 위한 HK-BANK 파격 예·적금 모듈</p>
        </section>

        <!-- Dynamic Rate Info Cards Grid -->
        <section class="grid grid-cols-4 gap-2">
            <div class="glass-panel p-2.5 rounded-xl text-center border border-purple-800">
                <div class="text-[11px] text-gray-400" data-i18n="t_6m">1년 미만</div>
                <div class="text-lg font-bold text-yellow-400 mt-0.5">6.0%</div>
                <div class="text-[9px] text-purple-300" data-i18n="sub_6m">단기 거치</div>
            </div>
            <div class="glass-panel p-2.5 rounded-xl text-center border border-purple-600 bg-purple-900/20">
                <div class="text-[11px] text-gray-400" data-i18n="t_1y">1년 만기</div>
                <div class="text-lg font-bold text-yellow-400 mt-0.5">13.0%</div>
                <div class="text-[9px] text-purple-300" data-i18n="sub_1y">수익 극대화</div>
            </div>
            <div class="glass-panel p-2.5 rounded-xl text-center border border-purple-500 bg-purple-900/30">
                <div class="text-[11px] text-gray-400" data-i18n="t_2y">2년 만기</div>
                <div class="text-lg font-bold text-yellow-400 mt-0.5">16.0%</div>
                <div class="text-[9px] text-purple-300" data-i18n="sub_2y">안정 성장</div>
            </div>
            <div class="glass-panel p-2.5 rounded-xl text-center border border-yellow-500/60 bg-yellow-400/10 glow-effect">
                <div class="text-[11px] text-yellow-300 font-bold" data-i18n="t_3y">3년 만기</div>
                <div class="text-xl font-black text-yellow-400 mt-0.5">20.0%</div>
                <div class="text-[9px] text-yellow-200" data-i18n="sub_3y">최고 우대</div>
            </div>
        </section>

        <!-- Deposit / Savings Calculator Section -->
        <section class="glass-panel rounded-2xl p-5 border border-purple-700/50">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-purple-900/60">
                <h3 class="font-bold text-base text-yellow-400 flex items-center gap-2">
                    <i class="fas fa-calculator"></i> <span data-i18n="calc_title">이자 계산 시뮬레이터</span>
                </h3>
                <div class="flex bg-purple-950 p-1 rounded-lg text-xs">
                    <button id="type-deposit" onclick="setProductType('deposit')" class="px-3 py-1 rounded-md bg-purple-600 text-yellow-400 font-bold" data-i18n="btn_deposit">정기예금</button>
                    <button id="type-saving" onclick="setProductType('saving')" class="px-3 py-1 rounded-md text-gray-400 hover:text-white" data-i18n="btn_saving">정기적금</button>
                </div>
            </div>

            <!-- Amount Input -->
            <div class="space-y-2 mb-4">
                <label class="text-xs text-gray-300 flex justify-between">
                    <span data-i18n="label_amount">예치 금액 (Pi / KRW)</span>
                    <span id="amount-display-val" class="text-yellow-400 font-bold">10,000,000 원</span>
                </label>
                <div class="relative">
                    <input type="number" id="deposit-amount" value="10000000" oninput="calculateInterest()" class="w-full bg-purple-950/80 border border-purple-700 rounded-xl py-2.5 px-3 text-right text-white font-bold text-lg focus:outline-none focus:border-yellow-400 pr-12">
                    <span class="absolute right-3 top-3 text-xs text-purple-400 font-bold" data-i18n="currency">원</span>
                </div>
                <div class="grid grid-cols-4 gap-1.5 pt-1">
                    <button onclick="addAmount(1000000)" class="text-xs bg-purple-900/40 hover:bg-purple-800 text-purple-200 py-1 rounded-lg border border-purple-700/50">+1M</button>
                    <button onclick="addAmount(5000000)" class="text-xs bg-purple-900/40 hover:bg-purple-800 text-purple-200 py-1 rounded-lg border border-purple-700/50">+5M</button>
                    <button onclick="addAmount(10000000)" class="text-xs bg-purple-900/40 hover:bg-purple-800 text-purple-200 py-1 rounded-lg border border-purple-700/50">+10M</button>
                    <button onclick="addAmount(50000000)" class="text-xs bg-purple-900/40 hover:bg-purple-800 text-purple-200 py-1 rounded-lg border border-purple-700/50">+50M</button>
                </div>
            </div>

            <!-- Period Selection -->
            <div class="space-y-2 mb-5">
                <label class="text-xs text-gray-300" data-i18n="label_period">약정 기간 선택</label>
                <div class="grid grid-cols-4 gap-2">
                    <button onclick="setPeriod(0.5, 6.0)" id="period-6m" class="period-btn py-2 text-xs rounded-xl border border-purple-700 bg-purple-950 text-gray-300 font-medium"><span data-i18n="p_6m">1년 미만</span><br><span class="text-yellow-400 font-bold">6.0%</span></button>
                    <button onclick="setPeriod(1, 13.0)" id="period-1y" class="period-btn py-2 text-xs rounded-xl border border-yellow-400 bg-purple-700 text-yellow-400 font-bold"><span data-i18n="p_1y">1년</span><br><span>13.0%</span></button>
                    <button onclick="setPeriod(2, 16.0)" id="period-2y" class="period-btn py-2 text-xs rounded-xl border border-purple-700 bg-purple-950 text-gray-300 font-medium"><span data-i18n="p_2y">2년</span><br><span class="text-yellow-400 font-bold">16.0%</span></button>
                    <button onclick="setPeriod(3, 20.0)" id="period-3y" class="period-btn py-2 text-xs rounded-xl border border-purple-700 bg-purple-950 text-gray-300 font-medium"><span data-i18n="p_3y">3년</span><br><span class="text-yellow-400 font-bold">20.0%</span></button>
                </div>
            </div>

            <!-- Calculation Result Box -->
            <div class="bg-purple-950/90 rounded-xl p-4 border border-purple-800 space-y-2.5">
                <div class="flex justify-between text-xs text-gray-400">
                    <span data-i18n="res_rate">적용 연 이율</span>
                    <span id="res-rate" class="text-yellow-400 font-bold">연 13.0%</span>
                </div>
                <div class="flex justify-between text-xs text-gray-400">
                    <span data-i18n="res_before">세전 총 이자</span>
                    <span id="res-before-tax" class="text-white font-medium">1,300,000 원</span>
                </div>
                <div class="flex justify-between text-xs text-gray-400">
                    <span data-i18n="res_tax">이자소득세 (15.4%)</span>
                    <span id="res-tax" class="text-red-400 font-medium">-200,200 원</span>
                </div>
                <div class="border-t border-purple-800/80 pt-2 flex justify-between items-center">
                    <span class="text-xs font-bold text-purple-200" data-i18n="res_total">만기 예상 실수령액</span>
                    <span id="res-total" class="text-lg font-black text-yellow-400">11,099,800 원</span>
                </div>
            </div>

            <button onclick="openApplyModal()" class="w-full mt-4 bg-gradient-to-r from-yellow-400 to-yellow-500 hover:from-yellow-300 hover:to-yellow-400 text-black font-extrabold py-3 rounded-xl shadow-lg transition text-sm" data-i18n="apply_btn">
                HK-BANK 상품 즉시 가입하기
            </button>
            <p class="text-[10px] text-gray-400 text-center mt-2" data-i18n="notice">※ 중도 해지 시 약정 이율의 8.5% 중도해지 수수료가 적용됩니다.</p>
        </section>

        <!-- 10 Core Modules Grid Header -->
        <section class="space-y-3">
            <div class="flex justify-between items-center px-1">
                <h3 class="font-bold text-sm text-purple-200 flex items-center gap-1.5">
                    <i class="fas fa-cubes text-yellow-400"></i> <span data-i18n="mod_title">HK WorldBank 10대 핵심 모듈</span>
                </h3>
                <span class="text-[11px] text-purple-400">Web3 Ecosystem</span>
            </div>

            <div class="grid grid-cols-2 gap-2.5">
                <div onclick="openModuleModal(1)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-wallet"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">1. <span data-i18n="m1">지갑연결</span></div>
                        <div class="text-[10px] text-gray-400">Pi Direct Link</div>
                    </div>
                </div>
                <div onclick="openModuleModal(2)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-paper-plane"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">2. <span data-i18n="m2">송금</span></div>
                        <div class="text-[10px] text-gray-400">Global Transfer</div>
                    </div>
                </div>
                <div onclick="openModuleModal(3)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-qrcode"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">3. <span data-i18n="m3">결제</span></div>
                        <div class="text-[10px] text-gray-400">QR Payment</div>
                    </div>
                </div>
                <div onclick="openModuleModal(4)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-piggy-bank"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">4. <span data-i18n="m4">예치</span></div>
                        <div class="text-[10px] text-gray-400">High Yield Deposit</div>
                    </div>
                </div>
                <div onclick="openModuleModal(5)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-gift"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">5. <span data-i18n="m5">보상</span></div>
                        <div class="text-[10px] text-gray-400">Ecosystem Reward</div>
                    </div>
                </div>
                <div onclick="openModuleModal(6)" class="glass-panel p-3 rounded-xl border border-yellow-500/40 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3 bg-yellow-400/5">
                    <div class="w-9 h-9 rounded-lg bg-yellow-400/20 flex items-center justify-center text-yellow-400"><i class="fas fa-hand-holding-usd"></i></div>
                    <div>
                        <div class="text-xs font-bold text-yellow-400">6. <span data-i18n="m6">기본소득</span></div>
                        <div class="text-[10px] text-yellow-200/70">30% UBI Return</div>
                    </div>
                </div>
                <div onclick="openModuleModal(7)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-sync-alt"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">7. <span data-i18n="m7">스왑</span></div>
                        <div class="text-[10px] text-gray-400">Instant Exchange</div>
                    </div>
                </div>
                <div onclick="openModuleModal(8)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-exchange-alt"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">8. <span data-i18n="m8">DEX 스왑</span></div>
                        <div class="text-[10px] text-gray-400">Decentralized P2P</div>
                    </div>
                </div>
                <div onclick="openModuleModal(9)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-layer-group"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">9. <span data-i18n="m9">LP 스테이킹</span></div>
                        <div class="text-[10px] text-gray-400">Liquidity Pool</div>
                    </div>
                </div>
                <div onclick="openModuleModal(10)" class="glass-panel p-3 rounded-xl border border-purple-800/60 hover:border-yellow-400 cursor-pointer transition flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-lg bg-purple-900/60 flex items-center justify-center text-yellow-400"><i class="fas fa-coins"></i></div>
                    <div>
                        <div class="text-xs font-bold text-white">10. <span data-i18n="m10">테스트 파이</span></div>
                        <div class="text-[10px] text-gray-400">Test Pi Sim</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Customer Center Assistant Bbini -->
        <section class="glass-panel rounded-2xl p-4 border border-purple-700/60 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-600 to-yellow-400 flex items-center justify-center font-bold text-black text-lg">
                    <i class="fas fa-robot"></i>
                </div>
                <div>
                    <div class="text-xs font-bold text-white flex items-center gap-1.5">
                        <span data-i18n="bbini_title">고객센터 AGI 삐니</span>
                        <span class="px-1.5 py-0.2 rounded text-[9px] bg-purple-900 text-yellow-400 border border-purple-600" data-i18n="bbini_badge">60 Languages</span>
                    </div>
                    <div class="text-[10px] text-gray-400" data-i18n="bbini_desc">24/7 Global AI Financial Support</div>
                </div>
            </div>
            <button onclick="openModuleModal('bbini')" class="text-xs bg-purple-800 hover:bg-purple-700 text-yellow-300 font-bold px-3 py-1.5 rounded-lg border border-purple-500/40" data-i18n="bbini_btn">
                상담하기
